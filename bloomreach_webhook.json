{
  "customer_ids": {
    "cookie": {% if customer_ids.cookie %}
      {% if customer_ids.cookie is string %}
        {% if customer.extra_data and customer.extra_data != customer_ids.cookie %}
          [{{ customer_ids.cookie | json }}, {{ customer.extra_data | json }}]
        {% else %}
          {{ customer_ids.cookie | json }}
        {% endif %}
      {% else %}
        {% if customer.extra_data and customer.extra_data not in customer_ids.cookie %}
          {{ (customer_ids.cookie + [customer.extra_data]) | json }}
        {% else %}
          {{ customer_ids.cookie | json }}
        {% endif %}
      {% endif %}
    {% else %}
      {% if customer.extra_data %}
        {{ customer.extra_data | json }}
      {% else %}
        null
      {% endif %}
    {% endif %},
