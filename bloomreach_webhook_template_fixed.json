{% if customer_ids.cookie is string %}
  {% if customer_ids.cookie != customer.extra_data %}
    {% set new_cookie = [customer_ids.cookie] %}
    {% if customer.extra_data %}
      {% append customer.extra_data to new_cookie %}
    {% endif %}
    {% set final_cookie = new_cookie %}
  {% else %}
    {% set final_cookie = [customer_ids.cookie] %}
  {% endif %}
{% elif customer_ids.cookie is iterable %}
  {% set new_cookie = customer_ids.cookie %}
  {% if customer.extra_data and customer.extra_data not in new_cookie %}
    {% append customer.extra_data to new_cookie %}
  {% endif %}
  {% set final_cookie = new_cookie %}
{% else %}
  {% if customer.extra_data %}
    {% set final_cookie = [customer.extra_data] %}
  {% else %}
    {% set final_cookie = [] %}
  {% endif %}
{% endif %}

{
  "customer_ids": {
    "email_id": {{ customer_ids.email_id | json }},
    "cookie": {{ final_cookie | json }}
  }
}